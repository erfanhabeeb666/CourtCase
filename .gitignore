# Root .gitignore for CourtCase project
# Covers both Java/Maven backend and Node/Vite frontend

# General
.DS_Store
Thumbs.db
*.log
logs/
*.tmp
.tmp/
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json

# Node / Frontend
node_modules/
**/node_modules/

# Build outputs
build/
dist/
.out/
.next/
.nuxt/
.vite/
**/.vite/

# Env files
.env
**/.env
.env.*

# Coverage / reports
coverage/
.cypress/
.playwright/
reports/

# Lockfiles (optional; keep if you prefer deterministic installs)
# yarn.lock
# pnpm-lock.yaml
# package-lock.json

# Java / Maven / Gradle (Backend)
backend/target/
**/target/
*.class
*.jar
*.war
*.ear

# IDE / project files
.classpath
.project
.settings/
*.iml

# Bin directories generated by IDEs/builds
bin/
**/bin/

# OS / misc
.Spotlight-V100
.Trashes

# Postman local artifacts (if any)
.postman/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/backend/uploads
